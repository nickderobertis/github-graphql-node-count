{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-setup.sh\"",
            "timeout": 180,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just bootstrap)",
      "Bash(just toolchain)",
      "Bash(just check)",
      "Bash(just check all)",
      "Bash(just test)",
      "Bash(just test-e2e)",
      "Bash(just lint)",
      "Bash(just fmt-check)",
      "Bash(just format)",
      "Bash(just doc)",
      "Bash(just coverage)",
      "Bash(just deps-check)",
      "Bash(just msrv)",
      "Bash(just install-smoke)",
      "Bash(just upgrade)",
      "Bash(just session-setup)",
      "Bash(just setup-llmlint)",
      "Bash(just lint-llm)",
      "Bash(just lint-llm-validate:*)",
      "Bash(just lint-llm-diff:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo update --dry-run)",
      "Bash(npm outdated)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git commit:*)"
    ],
    "deny": []
  }
}
